  <!-- ==========================================
       JAVASCRIPT LOGIC
       ========================================== -->
  <script>
    // --- Config & Variables ---
    const CORRECT_CODE = "0411";
    let currentInput = "";
    let isSnapped = false;

    // --- Page Navigation ---
    function goToPage(pageNum) {
      document.querySelectorAll('.page-section').forEach(sec => {
        sec.classList.remove('active');
      });
      const target = document.getElementById(`page${pageNum}`);
      if (target) {
        target.classList.add('active');
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }

      // Reset Passcode if loop back to Page 1
      if (pageNum === 1) {
        resetLock();
      }
    }

    // --- Page 1: Typewriter & Keypad Logic ---
    const titleText = "Please enter the correct password";
    let typeIdx = 0;

    function typeWriter() {
      if (typeIdx < titleText.length) {
        document.getElementById("typewriterText").innerHTML += titleText.charAt(typeIdx);
        typeIdx++;
        setTimeout(typeWriter, 50);
      }
    }

    // Capture Keyboard Input for Pin
    document.addEventListener('keydown', (e) => {
      const activePage = document.getElementById('page1').classList.contains('active');
      if (!activePage) return;

      if (e.key >= '0' && e.key <= '9') {
        if (currentInput.length < 4) {
          currentInput += e.key;
          updateDigitBoxes();
        }
      } else if (e.key === 'Backspace') {
        currentInput = currentInput.slice(0, -1);
        updateDigitBoxes();
      }

      if (currentInput.length === 4) {
        checkPassword();
      }
    });

    function updateDigitBoxes() {
      for (let i = 0; i < 4; i++) {
        const box = document.getElementById(`digit-${i}`);
        if (i < currentInput.length) {
          box.innerText = "•";
          box.classList.add('active');
        } else {
          box.innerText = "";
          box.classList.remove('active');
        }
      }
    }

    function checkPassword() {
      const errorEl = document.getElementById('errorMsg');
      const container = document.getElementById('passContainer');

      if (currentInput === CORRECT_CODE) {
        errorEl.innerText = "";
        setTimeout(() => {
          goToPage(2);
        }, 300);
      } else {
        errorEl.innerText = "try again love !!!";
        container.classList.add('shake');
        setTimeout(() => {
          container.classList.remove('shake');
          currentInput = "";
          updateDigitBoxes();
        }, 500);
      }
    }

    function resetLock() {
      currentInput = "";
      typeIdx = 0;
      document.getElementById("typewriterText").innerHTML = "";
      document.getElementById('errorMsg').innerText = "";
      updateDigitBoxes();
      typeWriter();
    }

    // --- Page 3: Audio Control ---
    function togglePlay() {
      const audio = document.getElementById('bgMusic');
      const cassette = document.getElementById('cassette');
      if (audio.paused) {
        audio.play();
        cassette.classList.add('spinning');
      } else {
        audio.pause();
        cassette.classList.remove('spinning');
      }
    }

    // --- Page 4: Camera Snap & Card Flip ---
    function snapPhoto() {
      if (isSnapped) return; // กดถ่ายได้ 1 ครั้ง
      isSnapped = true;

      // Flash Effect
      const flash = document.getElementById('flash');
      flash.classList.add('flash-active');
      setTimeout(() => flash.classList.remove('flash-active'), 500);

      // Hide Camera hint & Show Gallery
      document.getElementById('cameraBtn').style.display = 'none';
      document.getElementById('galleryArea').style.display = 'block';
    }

    function flipCard(card) {
      card.classList.toggle('flipped');
    }

    // Initialize Page 1
    window.onload = () => {
      typeWriter();
    };
  </script>
</body>
</html>

<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Secret Love Code 🗝️</title>
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Charm:wght@400;700&family=Courier+Prime:ital,wght@0,400;0,700;1,400&family=Sarabun:wght@300;400;600&display=swap" rel="stylesheet">
  
  <style>
    /* --------------------------------------------------
       CSS VARIABLES & BASE STYLES
       -------------------------------------------------- */
    :root {
      --bg-color: #f5f0eb;        /* Vintage Muted Cream */
      --text-main: #4a3f35;       /* Muted Warm Brown */
      --text-muted: #8c7b6c;      /* Soft Taupe */
      --accent-rose: #c89696;     /* Muted Dusty Rose */
      --accent-sage: #7d8c7c;     /* Muted Sage Green */
      --box-brown: #c49a6c;       /* Muted Cardboard Brown */
      --tape-body: #3a3836;       /* Retro Cassette Black/Gray */
      --error-color: #ba5d5d;
      --font-code: 'Courier Prime', monospace;
      --font-hand: 'Charm', cursive;
      --font-body: 'Sarabun', sans-serif;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      user-select: none;
    }

    body {
      background-color: var(--bg-color);
      color: var(--text-main);
      font-family: var(--font-body);
      min-height: 100vh;
      overflow-x: hidden;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    /* Container สไตล์ Frame ป้องกันไม่ให้กว้างเกินไปบนจอคอม */
    .app-container {
      width: 100%;
      max-width: 480px;
      min-height: 100vh;
      background-color: var(--bg-color);
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 2rem 1.5rem;
      box-shadow: 0 0 30px rgba(0,0,0,0.03);
    }

    /* Section Management */
    .page-section {
      display: none;
      width: 100%;
      flex-direction: column;
      align-items: center;
      text-align: center;
      opacity: 0;
      transition: opacity 0.8s ease-in-out;
    }

    .page-section.active {
      display: flex;
      opacity: 1;
    }

    /* Buttons */
    .btn-next {
      margin-top: 2rem;
      background: none;
      border: 1px dashed var(--accent-sage);
      color: var(--accent-sage);
      padding: 0.6rem 1.5rem;
      font-family: var(--font-code);
      font-size: 1rem;
      border-radius: 20px;
      cursor: pointer;
      transition: all 0.3s ease;
    }

    .btn-next:hover {
      background-color: var(--accent-sage);
      color: #fff;
    }

    /* --------------------------------------------------
       SECTION 1: PASSWORD LOCK
       -------------------------------------------------- */
    .lock-title {
      font-family: var(--font-code);
      font-size: 1.1rem;
      letter-spacing: 1px;
      margin-bottom: 1.5rem;
      min-height: 2.5rem;
    }

    .pass-input-container {
      display: flex;
      gap: 12px;
      margin-bottom: 1.5rem;
    }

    .digit-box {
      width: 45px;
      height: 55px;
      border: 2px solid var(--text-muted);
      border-radius: 8px;
      font-family: var(--font-code);
      font-size: 1.8rem;
      text-align: center;
      line-height: 55px;
      background: rgba(255, 255, 255, 0.4);
      color: var(--text-main);
      transition: all 0.3s ease;
    }

    .digit-box.active {
      border-color: var(--accent-rose);
      box-shadow: 0 0 8px rgba(200, 150, 150, 0.3);
    }

    .hint-text {
      font-family: var(--font-code);
      font-size: 0.75rem;
      color: var(--text-muted);
      margin-top: 1rem;
      opacity: 0.8;
    }

    .error-msg {
      color: var(--error-color);
      font-family: var(--font-code);
      font-size: 0.9rem;
      margin-top: 0.8rem;
      height: 1.2rem;
    }

    /* Animation สั่นเมื่อผิด */
    .shake {
      animation: shake 0.4s ease-in-out;
    }

    @keyframes shake {
      0%, 100% { transform: translateX(0); }
      20%, 60% { transform: translateX(-8px); }
      40%, 80% { transform: translateX(8px); }
    }

    /* --------------------------------------------------
       SECTION 2: PARCEL BOX DROP
       -------------------------------------------------- */
    .drop-box-container {
      cursor: pointer;
      position: relative;
      margin: 2rem 0;
      animation: dropDown 1.2s cubic-bezier(0.175, 0.885, 0.32, 1.27) forwards;
    }

    @keyframes dropDown {
      0% { transform: translateY(-300px); opacity: 0; }
      100% { transform: translateY(0); opacity: 1; }
    }

    /* SVG กล่องพัสดุ */
    .parcel-svg {
      width: 180px;
      height: 180px;
      filter: drop-shadow(0 10px 15px rgba(0,0,0,0.05));
      transition: transform 0.3s ease;
    }

    .drop-box-container:hover .parcel-svg {
      transform: scale(1.05);
    }

    .box-heading {
      font-family: var(--font-hand);
      font-size: 2rem;
      color: var(--text-main);
      margin-bottom: 0.5rem;
    }

    .tap-hint {
      font-family: var(--font-code);
      font-size: 0.8rem;
      color: var(--text-muted);
      letter-spacing: 2px;
      animation: pulse 1.5s infinite;
    }

    @keyframes pulse {
      0%, 100% { opacity: 0.4; }
      50% { opacity: 1; }
    }

    /* --------------------------------------------------
       SECTION 3: CASSETTE & LETTER (SCROLLABLE)
       -------------------------------------------------- */
    .scrollable-content {
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 2.5rem;
    }

    /* Cassette Tape */
    .cassette {
      width: 260px;
      height: 160px;
      background-color: var(--tape-body);
      border-radius: 12px;
      padding: 12px;
      position: relative;
      box-shadow: 0 8px 20px rgba(0,0,0,0.15);
    }

    .cassette-label {
      width: 100%;
      height: 90px;
      background: #e8e2d8;
      border-radius: 6px;
      border: 2px solid var(--accent-rose);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: space-around;
      padding: 6px;
    }

    .cassette-title {
      font-family: var(--font-hand);
      font-size: 1.1rem;
      color: var(--text-main);
    }

    .reels {
      display: flex;
      gap: 40px;
    }

    .reel {
      width: 35px;
      height: 35px;
      background: #fff;
      border-radius: 50%;
      border: 4px solid var(--tape-body);
      position: relative;
    }

    .reel::after {
      content: '';
      position: absolute;
      top: 50%; left: 50%;
      transform: translate(-50%, -50%);
      width: 10px; height: 10px;
      background: var(--tape-body);
      border-radius: 50%;
    }

    .spinning .reel {
      animation: spin 3s linear infinite;
    }

    @keyframes spin {
      100% { transform: rotate(360deg); }
    }

    /* Custom Player Control Area */
    .player-controls {
      margin-top: 10px;
      display: flex;
      gap: 15px;
      align-items: center;
    }

    .play-btn {
      background: var(--accent-sage);
      color: white;
      border: none;
      padding: 6px 16px;
      border-radius: 15px;
      font-family: var(--font-code);
      font-size: 0.8rem;
      cursor: pointer;
    }

    /* Letter Box */
    .letter-box {
      width: 100%;
      background: #faf7f2;
      border: 1px solid #e0d8ce;
      padding: 1.8rem;
      border-radius: 8px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.02);
      text-align: left;
      font-family: var(--font-body);
      line-height: 1.8;
      color: var(--text-main);
      position: relative;
    }

    .letter-box::before {
      content: "✉️";
      position: absolute;
      top: -15px;
      right: 20px;
      font-size: 1.5rem;
    }

    /* --------------------------------------------------
       SECTION 4: POLAROID & GALLERY & BOUQUET
       -------------------------------------------------- */
    .camera-container {
      margin-bottom: 2rem;
      cursor: pointer;
    }

    .camera-svg {
      width: 110px;
      height: 110px;
      transition: transform 0.2s;
    }

    .camera-container:hover .camera-svg {
      transform: scale(1.05);
    }

    /* Flash Effect */
    .flash-overlay {
      position: fixed;
      top: 0; left: 0; right: 0; bottom: 0;
      background: white;
      opacity: 0;
      pointer-events: none;
      z-index: 999;
    }

    .flash-active {
      animation: flashAnim 0.5s ease-out;
    }

    @keyframes flashAnim {
      0% { opacity: 1; }
      100% { opacity: 0; }
    }

    /* Polaroid Cards Container */
    .gallery-container {
      display: flex;
      flex-direction: column;
      gap: 2rem;
      width: 100%;
      align-items: center;
      margin-top: 1rem;
    }

    /* Flip Card Style */
    .polaroid-card {
      width: 240px;
      height: 290px;
      perspective: 1000px;
      cursor: pointer;
    }

    .polaroid-inner {
      position: relative;
      width: 100%;
      height: 100%;
      text-align: center;
      transition: transform 0.6s cubic-bezier(0.4, 0.2, 0.2, 1);
      transform-style: preserve-3d;
      box-shadow: 0 6px 18px rgba(0,0,0,0.06);
      background: #fff;
      padding: 12px 12px 40px 12px;
      border-radius: 4px;
    }

    .polaroid-card.flipped .polaroid-inner {
      transform: rotateY(180deg);
    }

    .polaroid-front, .polaroid-back {
      position: absolute;
      top: 0; left: 0;
      width: 100%;
      height: 100%;
      backface-visibility: hidden;
      padding: 12px 12px 35px 12px;
      display: flex;
      flex-direction: column;
      align-items: center;
      border-radius: 4px;
      background: #fff;
    }

    .polaroid-img-placeholder {
      width: 100%;
      height: 200px;
      background-color: #eee9e0;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--text-muted);
      font-size: 0.8rem;
      border-radius: 2px;
      object-fit: cover;
    }

    .polaroid-caption {
      margin-top: 10px;
      font-family: var(--font-hand);
      font-size: 1.1rem;
      color: var(--text-main);
    }

    .polaroid-back {
      transform: rotateY(180deg);
      justify-content: center;
      padding: 20px;
      background: #faf6f0;
      border: 1px dashed var(--accent-rose);
    }

    .polaroid-back p {
      font-family: var(--font-hand);
      font-size: 1.2rem;
      color: var(--text-main);
      line-height: 1.5;
    }

    /* Flower Bouquet & Ending */
    .bouquet-area {
      margin-top: 3rem;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .bouquet-icon {
      font-size: 4rem;
      margin-bottom: 1rem;
      animation: float 3s ease-in-out infinite;
    }

    @keyframes float {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-8px); }
    }

    .final-quote {
      font-family: var(--font-body);
      font-weight: 300;
      font-size: 1.1rem;
      line-height: 1.8;
      color: var(--text-main);
      margin: 1.5rem 0;
    }

    .loop-btn {
      margin-top: 2rem;
      font-family: var(--font-code);
      font-size: 0.85rem;
      color: var(--text-muted);
      background: none;
      border: none;
      cursor: pointer;
      text-decoration: underline;
      transition: color 0.3s;
    }

    .loop-btn:hover {
      color: var(--accent-rose);
    }
  </style>
</head>
<body>

